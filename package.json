{
  "name": "flatup-ai-os",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "FLATUP GYM の AI スタッフ「AIKA」を Claude で動かすための運用 OS",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "list": "tsx src/index.ts --list",
    "reel": "tsx src/reel/generate.ts",
    "movie": "tsx src/movie/generate.ts",
    "movie:adopt": "tsx src/movie/adopt.ts",
    "movie:mac": "bash scripts/movie.command",
    "factory": "tsx src/factory/run.ts",
    "reel:batch": "tsx src/factory/batch.ts",
    "img": "tsx src/reel/image.ts",
    "anime:ep1": "bash scripts/anime_ep1.sh",
    "anime:ep1:images": "tsx src/reel/animeEp1Images.ts",
    "anime:ep1:video": "tsx src/reel/animeEp1Video.ts",
    "anime:ep1:motion": "bash scripts/anime_ep1_kenburns.sh",
    "anime:ep1:motion:selftest": "bash scripts/anime_ep1_kenburns.sh --selftest",
    "anime:ep1:stitch": "bash scripts/anime_ep1_stitch.sh",
    "test:safety": "tsx src/safety/receptionist.test.ts",
    "test:pii": "tsx src/utils/sanitizePii.test.ts",
    "test:routes": "OPENROUTER_API_KEY= tsx src/test/routes.test.ts",
    "test:customers": "tsx src/modules/customers.test.ts",
    "test:factory": "tsx src/factory/factory.test.ts",
    "test:reel": "tsx src/reel/promptBank.test.ts && tsx src/reel/seedance.test.ts && tsx src/reel/animeEp1Video.test.ts && tsx src/reel/characters.test.ts",
    "test:movie": "tsx src/movie/promptBank.test.ts && tsx src/movie/editPlan.test.ts && tsx src/movie/bible.test.ts",
    "test": "npm run typecheck && npm run test:safety && npm run test:pii && npm run test:routes && npm run test:customers && npm run test:reel && npm run test:factory && npm run test:movie"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
